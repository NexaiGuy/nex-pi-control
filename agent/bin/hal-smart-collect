#!/opt/hal-agent/venv/bin/python
"""Draait als root via hal-smart-collect.timer. Leest SMART (enkel leescommando's) en schrijft JSON
naar /var/lib/hal-agent/smart/<schijf>.json (root:halagent 0640). hal-agent leest die bestanden.

Elke schijf uit lsblk komt erin, ook USB-SSD's, SD-kaarten en schijven zonder SMART, met hun partities.
USB-adapters (bridges) geven SMART vaak enkel door met een expliciet type (-d sat, -d sntasmedia, ...).
Het eerste type dat echte gezondheidsgegevens oplevert, wordt per schijf onthouden in probe.cache,
zodat we niet elke 5 minuten opnieuw proberen. Een adapter die niets doorgeeft, wordt 24 uur niet opnieuw getest.
"""

import grp
import json
import os
import subprocess
import sys
import time

OUT = "/var/lib/hal-agent/smart"
CACHE = os.path.join(OUT, "probe.cache")  # bewust geen .json: de agent leest enkel <schijf>.json
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C.UTF-8"}
SMARTCTL = "/usr/sbin/smartctl"
USB_TYPES = ("sat", "sat,12", "sntasmedia", "sntrealtek", "sntjmicron")
RETRY_UNSUPPORTED = 24 * 3600


def lsblk():
    cols = "NAME,TYPE,SIZE,TRAN,MODEL,SERIAL,FSTYPE,LABEL,MOUNTPOINTS,RM"
    r = subprocess.run(["lsblk", "-J", "-b", "-o", cols], capture_output=True, text=True, env=ENV, timeout=20)
    return json.loads(r.stdout or "{}").get("blockdevices", [])


def partitions(dev):
    out = []
    for c in dev.get("children") or []:
        mps = [m for m in (c.get("mountpoints") or []) if m]
        out.append({"device": f"/dev/{c.get('name')}", "size_bytes": int(c.get("size") or 0), "fstype": c.get("fstype") or "",
                    "label": c.get("label") or "", "mountpoints": mps})
        out.extend(partitions(c))  # LVM, crypt
    return out


def disks():
    for d in lsblk():
        name = d.get("name", "")
        if d.get("type") != "disk" or name.startswith(("zram", "loop", "ram")):
            continue
        yield {
            "name": name, "size": int(d.get("size") or 0), "model": (d.get("model") or "").strip(), "tran": d.get("tran") or "",
            "serial": (d.get("serial") or "").strip(), "removable": bool(d.get("rm")), "partitions": partitions(d),
        }


def smart(dev, dtype=None, opts=("-i", "-H", "-A")):
    argv = [SMARTCTL, "-j", *opts]
    if dtype:
        argv += ["-d", dtype]
    argv.append(f"/dev/{dev}")
    try:
        r = subprocess.run(argv, capture_output=True, text=True, env=ENV, timeout=60)
    except subprocess.TimeoutExpired:
        return 0b100, {}
    try:
        return r.returncode, json.loads(r.stdout or "{}")
    except ValueError:
        return r.returncode, {}


def has_data(data):
    return (isinstance(data.get("smart_status"), dict) or bool((data.get("ata_smart_attributes") or {}).get("table"))
            or isinstance(data.get("nvme_smart_health_information_log"), dict))


def load_cache():
    try:
        with open(CACHE) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_cache(cache):
    tmp = CACHE + ".tmp"
    with open(tmp, "w") as f:
        json.dump(cache, f)
    os.chmod(tmp, 0o600)
    os.replace(tmp, CACHE)


def read_disk(d, cache, now):
    """Geeft (exit_code, smartctl-json, gebruikt type, unsupported)."""
    name, key = d["name"], d["serial"] or d["name"]
    if name.startswith("mmcblk"):
        return 0, {}, "", True
    if d["tran"] != "usb":
        code, data = smart(name)
        return code, data, "", bool(code & 0b10) and not has_data(data)

    hit = cache.get(key) or {}
    if hit.get("type"):
        code, data = smart(name, hit["type"])
        if has_data(data):
            return code, data, hit["type"], False
    elif hit and now - hit.get("at", 0) < RETRY_UNSUPPORTED:
        code, data = smart(name)
        return code, data, "", not has_data(data)

    code, data = smart(name)
    if has_data(data):
        cache[key] = {"type": "", "at": now}
        return code, data, "", False
    for t in USB_TYPES:
        c2, d2 = smart(name, t)
        if has_data(d2):
            cache[key] = {"type": t, "at": now}
            return c2, d2, t, False
    cache[key] = {"type": None, "at": now}
    return code, data, "", True


def main():
    os.makedirs(OUT, exist_ok=True)
    try:
        gid = grp.getgrnam("halagent").gr_gid
    except KeyError:
        gid = 0
    now = int(time.time())
    cache = load_cache()
    seen = set()
    for d in disks():
        name = d["name"]
        seen.add(name)
        code, data, dtype, unsupported = read_disk(d, cache, now)
        errorlog = None
        if not unsupported and has_data(data):
            # Het foutlogboek apart: sommige USB-adapters (zoals bij de Transcend ESD310C) breken net dat
            # commando af terwijl gezondheid en attributen gewoon lezen. Dat is geen faalsignaal van de schijf.
            ecode, edata = smart(name, dtype or None, ("-l", "error"))
            aborted = bool(ecode & 0b110) and not edata.get("ata_smart_error_log") and not edata.get("nvme_error_information_log")
            errorlog = {"exit_code": ecode, "available": not aborted}
            if not aborted:
                code |= ecode & 0b1000000  # bit 6: het logboek bevat fouten
                for k in ("ata_smart_error_log", "nvme_error_information_log"):
                    if k in edata:
                        data[k] = edata[k]
        record = {
            "device": f"/dev/{name}", "collected_at": now, "size_bytes": d["size"], "model": d["model"], "transport": d["tran"],
            "serial": d["serial"], "removable": d["removable"], "partitions": d["partitions"],
            "exit_code": code, "smartctl": data, "unsupported": unsupported, "device_type": dtype, "error_log": errorlog,
        }
        path = os.path.join(OUT, f"{name}.json")
        tmp = path + ".tmp"
        with open(tmp, "w") as f:
            json.dump(record, f)
        os.chown(tmp, 0, gid)
        os.chmod(tmp, 0o640)
        os.replace(tmp, path)
    for f in os.listdir(OUT):
        if f.endswith(".json") and f[:-5] not in seen:
            os.unlink(os.path.join(OUT, f))
    save_cache(cache)
    return 0


if __name__ == "__main__":
    sys.exit(main())
