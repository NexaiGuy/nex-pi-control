#!/opt/hal-agent/venv/bin/python
"""Draait als root via hal-apt-check.service (timer: elke 6 uur). Ververst de pakketlijsten en schrijft welke
updates klaarstaan naar /var/lib/hal-agent/apt/status.json. Installeert zelf niets."""

import json
import os
import re
import subprocess
import sys
import time

OUT_DIR = "/var/lib/hal-agent/apt"
OUT = os.path.join(OUT_DIR, "status.json")
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LANG": "C", "LC_ALL": "C", "DEBIAN_FRONTEND": "noninteractive"}
LINE_RE = re.compile(r"^(?P<name>[^/\s]+)/(?P<suite>\S+)\s+(?P<to>\S+)\s+\S+\s+\[upgradable from: (?P<from>[^\]]+)\]")


def parse(text: str) -> list[dict]:
    pkgs = []
    for line in text.splitlines():
        m = LINE_RE.match(line.strip())
        if m:
            pkgs.append({"name": m["name"], "from": m["from"], "to": m["to"], "security": "security" in m["suite"]})
    pkgs.sort(key=lambda p: (not p["security"], p["name"]))
    return pkgs


INST_RE = re.compile(r"^Inst (\S+)", re.M)
REMV_RE = re.compile(r"^Remv (\S+)", re.M)


def simulate(args: list[str]) -> str:
    """apt-get -s: enkel simuleren, er wordt niets geïnstalleerd of verwijderd. Inst/Remv-regels zijn stabiel over apt-versies."""
    try:
        r = subprocess.run(["apt-get", "-s", "-q", "-o", "DPkg::Lock::Timeout=60", *args], capture_output=True, text=True, env=ENV, timeout=300)
        return r.stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def mark_held(pkgs: list[dict]) -> list[str]:
    """Welke updates `upgrade --with-new-pkgs` (wat de app installeert) niet meeneemt, en waarom.

    - hold: met apt-mark hold vastgezet;
    - phased: Debian/Raspberry Pi rolt de update gefaseerd uit, apt neemt hem later vanzelf mee;
    - removal: de nieuwe versie vraagt om een ander pakket te verwijderen (enkel via `sudo apt full-upgrade`).
    Geeft de pakketten terug die full-upgrade zou verwijderen.
    """
    if not pkgs:
        return []
    sim = simulate(["--with-new-pkgs", "upgrade"])
    if not sim:
        return []
    will = set(INST_RE.findall(sim))
    held = [p for p in pkgs if p["name"] not in will]
    if not held:
        return []
    holds = set(subprocess.run(["apt-mark", "showhold"], capture_output=True, text=True, env=ENV, timeout=60).stdout.split())
    phased = set()
    m = re.search(r"deferred due to phasing:\n((?:[ \t]+.*\n)+)", sim)
    if m:
        phased = {w for line in m.group(1).splitlines() for w in line.split()}
    removes = sorted(set(REMV_RE.findall(simulate(["full-upgrade"]))))
    for p in held:
        p["held"] = True
        p["reason"] = "hold" if p["name"] in holds else "phased" if p["name"] in phased else "removal" if removes else "other"
    return removes[:50]


def write(data: dict) -> None:
    os.makedirs(OUT_DIR, exist_ok=True)
    tmp = OUT + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f)
    os.chmod(tmp, 0o640)
    try:
        import grp

        os.chown(tmp, 0, grp.getgrnam("halagent").gr_gid)
    except (KeyError, OSError):
        pass
    os.replace(tmp, OUT)


def main() -> int:
    error = None
    u = subprocess.run(["apt-get", "update", "-q"], capture_output=True, text=True, env=ENV, timeout=600)
    if u.returncode != 0:
        error = (u.stderr or u.stdout).strip().splitlines()[-1:] or ["apt-get update failed"]
        error = error[0][:300]
        print(f"WARNING {error}")
    r = subprocess.run(["apt", "list", "--upgradable"], capture_output=True, text=True, env=ENV, timeout=120)
    pkgs = parse(r.stdout)
    removes = mark_held(pkgs)
    write({"checked_at": int(time.time()), "packages": pkgs, "full_upgrade_removes": removes,
           "reboot_required": os.path.exists("/var/run/reboot-required"), "error": error})
    held = [p["name"] for p in pkgs if p.get("held")]
    print(f"{len(pkgs) - len(held)} update(s) ready, {sum(1 for p in pkgs if p['security'] and not p.get('held'))} security"
          + (f", held back: {' '.join(held)}" + (f" (full-upgrade would remove: {' '.join(removes)})" if removes else "") if held else ""))
    return 0


if __name__ == "__main__":
    sys.exit(main())
