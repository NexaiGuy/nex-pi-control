{
  "expo": {
    "name": "Nex Pi Control",
    "slug": "nex-pi-control",
    "scheme": "nexpicontrol",
    "version": "1.5.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0B0B12",
    "primaryColor": "#8B5CF6",
    "newArchEnabled": true,
    "android": {
      "package": "be.nexai.picontrol",
      "versionCode": 14,
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.INTERNET"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "ios": {
      "bundleIdentifier": "be.nexai.picontrol",
      "supportsTablet": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-background-task",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050508",
          "image": "./assets/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Nex Pi Control only uses the camera to scan the QR code with your connection details.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Nex Pi Control uses biometrics to unlock the app."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#8B5CF6"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withReleaseSigning",
      [
        "./plugins/withFloatingIcon",
        {
          "enabled": true
        }
      ],
      [
        "./plugins/withWidgetLive",
        {
          "enabled": true
        }
      ],
      "./plugins/withFlexWindow",
      "expo-localization",
      [
        "react-native-android-widget",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/space-grotesk/300Light/SpaceGrotesk_300Light.ttf",
            "./node_modules/@expo-google-fonts/jetbrains-mono/300Light/JetBrainsMono_300Light.ttf"
          ],
          "widgets": [
            {
              "name": "PiPulse",
              "label": "Pulse",
              "description": "The observing eye and the temperature of your Pi",
              "minWidth": "40dp",
              "minHeight": "40dp",
              "targetCellWidth": 1,
              "targetCellHeight": 1,
              "resizeMode": "none",
              "previewImage": "./assets/widget-pulse.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiGlance",
              "label": "Glance",
              "description": "Status, temperature and CPU of your Pi",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "maxResizeWidth": "260dp",
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal",
              "previewImage": "./assets/widget-glance.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiVitals",
              "label": "Vitals",
              "description": "CPU, RAM, temperature and disk as four rings",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "maxResizeWidth": "260dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-vitals.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiStrip",
              "label": "Status strip",
              "description": "Status plus CPU, RAM, temperature and disk in one row",
              "minWidth": "250dp",
              "minHeight": "40dp",
              "targetCellWidth": 4,
              "targetCellHeight": 1,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "110dp",
              "resizeMode": "horizontal",
              "previewImage": "./assets/widget-strip.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiStatus",
              "label": "Overview",
              "description": "Status, four metrics, CPU of the last hour and the counts",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-overview.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiCommand",
              "label": "Command center",
              "description": "Health reasons, cores, memory, network, mounts and counts",
              "minWidth": "250dp",
              "minHeight": "180dp",
              "targetCellWidth": 4,
              "targetCellHeight": 3,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "360dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-command.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiBoard",
              "label": "Full board",
              "description": "Everything at once: load, uptime, disk I/O, sites, events and updates",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "560dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-board.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiSites",
              "label": "Sites",
              "description": "Up, warning and down, with the worst sites first",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-sites.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiContainers",
              "label": "Containers",
              "description": "Running, stopped and unhealthy containers",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-containers.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiBackups",
              "label": "Backups",
              "description": "Every backup job with its age",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-backups.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiDisks",
              "label": "Disks",
              "description": "Every mount, free space and SMART per disk",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-disks.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiNetwork",
              "label": "Network",
              "description": "Traffic in and out now and over 24 hours",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-network.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiFleet",
              "label": "Fleet",
              "description": "Up to four of your Pis side by side",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "maxResizeWidth": "460dp",
              "maxResizeHeight": "260dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-fleet.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "PiCover",
              "label": "Flex Window",
              "description": "For the cover screen of your Galaxy Z Flip: the Nex AI logo, then everything about your Pi at once",
              "minWidth": "352dp",
              "minHeight": "339dp",
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-cover.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "description": "Free Raspberry Pi monitor and manager by Nex AI."
  }
}
