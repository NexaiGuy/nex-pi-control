<?xml version="1.0" encoding="utf-8"?>
<!-- Flex Window, stap 3: alle parameters van de Pi. Native layout (geen afbeelding), zodat ze zich aanpast aan de
     dichtheid en de maat van het cover-scherm. Gevuld door CoverScreen.renderData met gegevens uit de JS-taak.
     Rechtsonder blijft vrij: daar zit de uitsparing van het cover-scherm. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nex_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nex_cover_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingTop="12dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp">

        <LinearLayout android:id="@+id/nex_cover_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/nex_cover_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#34F5C5" android:textSize="9sp" android:text="◆"/>
            <TextView android:id="@+id/nex_cover_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true" android:layout_marginStart="6dp"/>
            <TextView android:id="@+id/nex_cover_server" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="8dp"/>
            <TextView android:id="@+id/nex_cover_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="10sp" android:fontFamily="monospace" android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView android:id="@+id/nex_cover_alarm" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/nex_cover_alarm" android:maxLines="2" android:ellipsize="end" android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp" android:paddingBottom="5dp" android:textColor="#050508" android:textSize="11sp" android:visibility="gone" />

        <TextView android:id="@+id/nex_cover_reasons" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:maxLines="2" android:ellipsize="end" android:lineSpacingExtra="2dp" android:textColor="#F2F2F0" android:textSize="10.5sp" android:visibility="gone" />

        <ImageView android:id="@+id/nex_cover_band" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="8dp" android:importantForAccessibility="no" android:scaleType="fitXY" android:src="@drawable/nex_cover_band" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/nex_cover_m0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_m0_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="24sp" android:fontFamily="sans-serif-light" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/nex_cover_m1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_m1_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="24sp" android:fontFamily="sans-serif-light" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical">
                <TextView android:id="@+id/nex_cover_m2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_m2_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="24sp" android:fontFamily="sans-serif-light" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:orientation="vertical">
                <TextView android:id="@+id/nex_cover_m3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_m3_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="24sp" android:fontFamily="sans-serif-light" android:layout_marginTop="3dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_l0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_l0_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_l1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_l1_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_l2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_l2_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_l3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_l3_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_l4_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_l4_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_n0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_n0_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
            <ImageView android:id="@+id/nex_cover_n0_spark" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_n1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_n1_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
            <ImageView android:id="@+id/nex_cover_n1_spark" android:layout_width="match_parent" android:layout_height="10dp" android:layout_marginTop="2dp" android:scaleType="fitXY" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_r0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_r0_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
                <TextView android:id="@+id/nex_cover_r1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="8.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true"/>
                <TextView android:id="@+id/nex_cover_r1_value" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="10sp" android:fontFamily="monospace" android:gravity="end" android:layout_weight="1" android:layout_marginStart="6dp"/>
            </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="6dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"  android:background="@drawable/nex_cover_tile" android:orientation="vertical" android:paddingStart="7dp" android:paddingTop="6dp" android:paddingEnd="5dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/nex_cover_c0_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7sp" android:text="◆"/>
                    <TextView android:id="@+id/nex_cover_c0_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true" android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView android:id="@+id/nex_cover_c0_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/nex_cover_tile" android:orientation="vertical" android:paddingStart="7dp" android:paddingTop="6dp" android:paddingEnd="5dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/nex_cover_c1_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7sp" android:text="◆"/>
                    <TextView android:id="@+id/nex_cover_c1_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true" android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView android:id="@+id/nex_cover_c1_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/nex_cover_tile" android:orientation="vertical" android:paddingStart="7dp" android:paddingTop="6dp" android:paddingEnd="5dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/nex_cover_c2_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7sp" android:text="◆"/>
                    <TextView android:id="@+id/nex_cover_c2_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true" android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView android:id="@+id/nex_cover_c2_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="3dp"/>
            </LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:background="@drawable/nex_cover_tile" android:orientation="vertical" android:paddingStart="7dp" android:paddingTop="6dp" android:paddingEnd="5dp" android:paddingBottom="6dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/nex_cover_c3_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7sp" android:text="◆"/>
                    <TextView android:id="@+id/nex_cover_c3_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:textSize="7.5sp" android:fontFamily="sans-serif" android:letterSpacing="0.12" android:textAllCaps="true" android:layout_marginStart="4dp"/>
                </LinearLayout>
                <TextView android:id="@+id/nex_cover_c3_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#F2F2F0" android:textSize="13sp" android:fontFamily="monospace" android:layout_marginTop="3dp"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="34dp" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/nex_cover_foot" android:layout_width="0dp" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:includeFontPadding="false" android:textColor="#8A8A94" android:layout_weight="0.9" android:textSize="9sp" android:fontFamily="monospace"/>
            <FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
