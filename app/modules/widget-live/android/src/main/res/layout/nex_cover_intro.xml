<?xml version="1.0" encoding="utf-8"?>
<!-- Flex Window, stap 1 (3 s): het Nex AI-logo. Iets hoger dan het midden, weg van de uitsparing rechtsonder. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/nex_cover_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/nex_cover_bg">

    <ImageView
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="center"
        android:layout_marginBottom="24dp"
        android:contentDescription="Nex AI"
        android:scaleType="fitCenter"
        android:src="@drawable/nex_cover_logo" />
</FrameLayout>
